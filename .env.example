NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="hireflow-super-secret-access-token-key-32-chars-minimum"
JWT_REFRESH_SECRET="hireflow-super-secret-refresh-token-key-32-chars-minimum"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="hireflow-cookie-signing-secret-key-32-chars"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./uploads"
STORAGE_MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
